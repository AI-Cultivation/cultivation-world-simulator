msgstr ""
"{avatar} accepted the sect mission \"{title}\" at the request of fellow "
"disciple {issuer}. It is expected to take {duration} months."

msgid "sect_mission_result_success"
msgstr ""
"{avatar} successfully completed \"{title}\" and received {stones} Spirit "
"Stones and {contribution} sect contribution."

msgid "sect_mission_result_fail"
msgstr ""
"{avatar} was injured while carrying out \"{title}\", losing {damage} HP. "
"Current HP: {current}/{max}."

msgid "sect_mission_result_fail_death_append"
msgstr " The injuries were fatal, and they died on the spot."

msgid "sect_mission_story_prompt_success"
msgstr ""
"Develop the story around this specific sect mission title, describing task "
"details, setbacks, and the sect atmosphere, and end with the mission being "
"successfully completed. The task still takes place within the sect "
"headquarters and its attached areas."

msgid "sect_mission_story_prompt_fail"
msgstr ""
"Develop the story around this specific sect mission title, describing task "
"details, setbacks, and unexpected turns, and end with mission failure, "
"severe injury, or even near death. The task still takes place within the "
"sect headquarters and its attached areas."

