msgstr "當前位置不能布置陣法"

msgid "Formation cannot be set in current region"
msgstr "該陣法不能布置在當前區域"

msgid "Not enough spirit stones"
msgstr "靈石不足"

msgid "Current region"
msgstr "當前區域"

