# Treasure POI fallback keys. Keep the global msgid set aligned with zh-CN.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"

msgid "take_treasure_action_name"
msgstr "Prendre le trésor"

msgid "take_treasure_description"
msgstr "Tenter de prendre le trésor découvert à cet endroit."

msgid "take_treasure_requirements"
msgstr "Doit se trouver sur un trésor découvert."

msgid "Cannot resolve treasure: {poi}"
msgstr "Trésor introuvable : {poi}"

msgid "Treasure has faded away"
msgstr "Le trésor s est dissipé"

msgid "Treasure is unknown"
msgstr "Ce trésor est inconnu"

msgid "Treasure has already been claimed"
msgstr "Le trésor a déjà été pris"

msgid "Must be at the treasure to claim it"
msgstr "Doit être sur le trésor pour le prendre"

msgid "{avatar} failed to claim {treasure}."
msgstr "{avatar} n a pas réussi à prendre {treasure}."

msgid "{avatar} triggered the treasure's restriction at {treasure} and was injured for {damage} HP."
msgstr "{avatar} a déclenché la restriction de {treasure} et a perdu {damage} PV."

msgid "{avatar} found that the treasure at {treasure} had decayed beyond use."
msgstr "{avatar} a constaté que {treasure} était inutilisable."

msgid "{avatar} successfully claimed {item} from {treasure}."
msgstr "{avatar} a obtenu {item} de {treasure}."

msgid "{avatar} claimed {item} from {treasure}. {result}"
msgstr "{avatar} a pris {item} de {treasure}. {result}"

msgid "Leave『{new_name}』where it was found"
msgstr "Laisser『{new_name}』sur place"

msgid "{avatar_name} left {item_name} where it was found."
msgstr "{avatar_name} a laissé {item_name} sur place."

msgid "{realm} treasure"
msgstr "Trésor de {realm}"

msgid "An ancient treasure shines with a restrained spiritual radiance."
msgstr "Un ancien trésor brille d une lueur spirituelle contenue."

msgid "A strange spiritual radiance appeared somewhere in the world. A {realm} treasure seems to have emerged."
msgstr "Une lueur étrange est apparue dans le monde. Un trésor de {realm} semble avoir émergé."

msgid "The spiritual radiance of a treasure faded away before anyone could claim it."
msgstr "La lueur spirituelle d un trésor s est dissipée avant d être prise."

msgid "{avatar} discovered a treasure at {location}: {poi}"
msgstr "{avatar} a découvert un trésor à {location} : {poi}"

msgid "treasure_source_ancient_cultivator_relic"
msgstr "Relique d ancien cultivant"

msgid "treasure_source_spirit_vein_treasure"
msgstr "Trésor de veine spirituelle"

msgid "treasure_source_demon_king_relic"
msgstr "Relique du roi démon"

msgid "treasure_source_demonic_artifact"
msgstr "Artefact démoniaque"

msgid "treasure_source_meteorite_relic"
msgstr "Relique météoritique"

msgid "treasure_source_lost_sect_artifact"
msgstr "Artefact de secte perdue"
